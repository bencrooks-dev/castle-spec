{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bencrooks-dev/castle-spec/schemas/partner-submission-v0.1.schema.json",
  "title": "Partner Document Submission manifest or receipt",
  "description": "DRAFT v0.1. A manifest describing documents a partner submits to a carrier, or the receiver's receipt for one.",
  "oneOf": [{ "$ref": "#/$defs/manifest" }, { "$ref": "#/$defs/receipt" }],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "filename": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" },
    "requirement": {
      "anyOf": [
        {
          "enum": [
            "doc_bcp", "doc_dr", "doc_infosec", "doc_incident", "doc_privacy",
            "doc_ai_policy", "doc_ai_inventory", "doc_vendor", "doc_change",
            "doc_procedures", "doc_coi_eo", "doc_coi_cyber", "doc_license",
            "doc_financials", "doc_soc", "doc_ownership", "doc_references",
            "doc_agreement"
          ]
        },
        { "type": "string", "pattern": "^x-[a-z0-9][a-z0-9-]{0,62}$" }
      ]
    },
    "manifest": {
      "type": "object",
      "required": ["pds_version", "partner", "recipient", "submitted_by", "submitted_at", "items"],
      "additionalProperties": false,
      "properties": {
        "pds_version": { "const": "0.1" },
        "partner": {
          "type": "object",
          "required": ["legal_name", "kind"],
          "additionalProperties": false,
          "properties": {
            "legal_name": { "type": "string", "minLength": 1, "maxLength": 256 },
            "kind": { "enum": ["mga", "tpa"] },
            "id": { "type": "string", "maxLength": 128 }
          }
        },
        "recipient": {
          "type": "object",
          "required": ["legal_name"],
          "additionalProperties": false,
          "properties": {
            "legal_name": { "type": "string", "minLength": 1, "maxLength": 256 },
            "program": { "type": "string", "maxLength": 128 }
          }
        },
        "submitted_by": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 3, "maxLength": 128 },
            "email": { "type": "string", "maxLength": 254 }
          }
        },
        "submitted_at": { "type": "string", "format": "date-time" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["requirement", "filename", "media_type", "sha256", "size_bytes", "document_date"],
            "additionalProperties": false,
            "properties": {
              "requirement": { "$ref": "#/$defs/requirement" },
              "filename": { "$ref": "#/$defs/filename" },
              "media_type": { "type": "string", "maxLength": 128 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "document_date": { "$ref": "#/$defs/date" },
              "expires_on": { "$ref": "#/$defs/date" },
              "request_ref": { "type": "string", "maxLength": 128 }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "requirement": { "enum": ["doc_coi_eo", "doc_coi_cyber", "doc_license"] } }
                },
                "then": { "required": ["expires_on"] }
              }
            ]
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["pds_receipt_version", "received_at", "manifest_sha256", "items"],
      "additionalProperties": false,
      "properties": {
        "pds_receipt_version": { "const": "0.1" },
        "received_at": { "type": "string", "format": "date-time" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["filename", "status"],
            "additionalProperties": false,
            "properties": {
              "filename": { "$ref": "#/$defs/filename" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "status": { "enum": ["received", "stale", "rejected"] },
              "reason": {
                "enum": [
                  "digest_mismatch", "size_mismatch", "unknown_requirement",
                  "expired", "missing_expiry", "missing_file", "other"
                ]
              }
            },
            "if": { "properties": { "status": { "const": "rejected" } } },
            "then": { "required": ["reason"] }
          }
        }
      }
    }
  }
}
